Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^(home|28-2)/?$ / [R=301,L]
  RewriteRule ^nosotros/?$ /#nosotros [R=301,NE,L]
  RewriteRule ^tecnologia/?$ /#tecnologia [R=301,NE,L]
  RewriteRule ^servicios/?$ /#servicios [R=301,NE,L]
  RewriteRule ^contacto/?$ /#contacto [R=301,NE,L]
  RewriteRule ^tienda-deco/?$ /tienda/ [R=301,L]

  RewriteCond %{REQUEST_URI} !^/tienda(/|$)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
